# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated additional hosts accepted for OAuth requests (optional)
BETTER_AUTH_ALLOWED_HOSTS=admin.ezygocouriers.co.za
# Optional shared session-cookie domain for trusted subdomains.
BETTER_AUTH_COOKIE_DOMAIN=ezygocouriers.co.za
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# PostgreSQL
DB_HOST=db
DB_PORT=5432
DB_NAME=ezygo
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false

# Google OAuth
# Callback URL: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=EzyGo Couriers <auth@ezygocouriers.co.za>

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Automatic driver assignment
# Drivers must be within this pickup radius and have sent a recent location.
AUTO_ASSIGNMENT_RADIUS_KM=25
DRIVER_LOCATION_MAX_AGE_MINUTES=15

# PayFast
# Optional in sandbox mode: the app falls back to PayFast's published shared
# test credentials when both merchant values are blank.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
# Public HTTPS origin used for return, cancellation, and ITN callbacks.
# PayFast rejects localhost callback URLs. Defaults to NEXT_PUBLIC_APP_URL.
PAYFAST_APP_URL=
