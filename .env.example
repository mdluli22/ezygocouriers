# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated additional hosts accepted for OAuth requests (optional)
BETTER_AUTH_ALLOWED_HOSTS=
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# PostgreSQL
DB_HOST=db
DB_PORT=5432
DB_NAME=ezygo
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false

# Google OAuth
# Callback URL: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=EzyGo Couriers <auth@ezygocouriers.co.za>

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# PayFast
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
