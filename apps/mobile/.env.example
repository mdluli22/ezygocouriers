# Optional: without this override the app uses the production backend.
EXPO_PUBLIC_API_URL=https://ezygocouriers.co.za

# Local backend overrides (use only while the backend is running):
# iOS simulator: http://localhost:3000
# Android emulator: http://10.0.2.2:3000
# Physical device: http://YOUR_COMPUTERS_LAN_IP:3000

# Native push project and Android map renderer (restrict key to package/signature).
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
