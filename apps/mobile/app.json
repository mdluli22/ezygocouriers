{
  "expo": {
    "name": "EzyGo Couriers",
    "slug": "ezygo-couriers",
    "version": "0.1.0",
    "scheme": "ezygo",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "expo-web-browser"
    ],
    "ios": {
      "bundleIdentifier": "za.co.ezygocouriers.app",
      "supportsTablet": false
    },
    "android": {
      "package": "za.co.ezygocouriers.app"
    }
  }
}
