{
  "expo": {
    "name": "EzyGo Couriers",
    "slug": "ezygo-couriers",
    "version": "0.1.0",
    "scheme": "ezygo",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow EzyGo to share your location during a driver trip while the app is open.",
          "locationAlwaysAndWhenInUsePermission": "Allow EzyGo to share your active driver trip location in the background until you stop sharing or finish the trip.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-notifications"
    ],
    "ios": {
      "bundleIdentifier": "za.co.ezygocouriers.app",
      "supportsTablet": false
    },
    "android": {
      "package": "za.co.ezygocouriers.app"
    }
  }
}
