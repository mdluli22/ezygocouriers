{
  "name": "@ezygo/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/next.mjs dev",
    "build": "node scripts/next.mjs build --webpack",
    "start": "node scripts/next.mjs start",
