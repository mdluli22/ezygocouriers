    "test:smoke": "node scripts/smoke-release.mjs"
  },
  "dependencies": {
    "@ezygo/contracts": "*",
    "@vis.gl/react-google-maps": "^1.7.1",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.6.24",
    "lucide-react": "^1.7.0",
    "next": "^16.4.0",
    "nodemailer": "^10.0.10",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "web-push": "^3.6.7",
    "zod": "^4.3.6",
    "@ezygo/api-client": "*",
    "@next/env": "^16.3.5",
    "pg": "^8.20.0",
    "server-only": "^0.0.1"
