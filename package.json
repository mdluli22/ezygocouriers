{
  "name": "ezygocouriers",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @ezygo/web --",
    "dev:web": "npm run dev --workspace @ezygo/web --",
    "dev:mobile": "npm run start --workspace @ezygo/mobile --",
    "build": "npm run build --workspace @ezygo/web --",
    "start": "npm run start --workspace @ezygo/web --",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:contracts": "npm run typecheck --workspace @ezygo/contracts",
    "test": "npm run test --workspace @ezygo/api-client"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "react-native-gesture-handler": "~2.32.0"
  }
}
